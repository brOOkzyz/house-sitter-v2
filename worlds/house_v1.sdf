<?xml version="1.0"?>
<!-- house_v1: local primitive-only single-floor residence. No Fuel or remote URI. -->
<sdf version="1.7">
  <world name="house_v1">
    <physics type="ode"><max_step_size>0.003</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <scene><ambient>0.75 0.75 0.75 1</ambient><background>0.15 0.18 0.22 1</background><shadows>false</shadows></scene>
    <model name="house_floor"><static>true</static><pose>0 0 0 0 0 0</pose><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>12 10</size></plane></geometry><material><diffuse>0.72 0.62 0.48 1</diffuse></material></visual></link></model>

    <!-- Exterior envelope: 12 m x 10 m. Interior door openings are 1.3–1.5 m wide. -->
    <model name="wall_south"><static>true</static><pose>6 0.1 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>12 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.2 2.5</size></box></geometry><material><diffuse>0.92 0.91 0.86 1</diffuse></material></visual></link></model>
    <model name="wall_north"><static>true</static><pose>6 9.9 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>12 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.2 2.5</size></box></geometry><material><diffuse>0.92 0.91 0.86 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>0.1 5 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 10 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 2.5</size></box></geometry><material><diffuse>0.92 0.91 0.86 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>11.9 5 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 10 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 2.5</size></box></geometry><material><diffuse>0.92 0.91 0.86 1</diffuse></material></visual></link></model>

    <!-- Lower rooms / hallway walls; openings lead to living room and kitchen. -->
    <model name="living_door_wall_left"><static>true</static><pose>1.3 4 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.2 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>2.2 0.2 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>
    <model name="central_lower_wall"><static>true</static><pose>6.1 4 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>4.4 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>4.4 0.2 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>
    <model name="kitchen_door_wall_right"><static>true</static><pose>10.8 4 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>2 0.2 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>
    <model name="living_kitchen_divider"><static>true</static><pose>6 2.05 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 3.7 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 3.7 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>

    <!-- Upper rooms / hallway walls; openings lead to bedroom, bathroom and entrance. -->
    <model name="bedroom_door_wall_left"><static>true</static><pose>1.3 6 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>2.2 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>2.2 0.2 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>
    <model name="upper_middle_wall"><static>true</static><pose>5.5 6 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3.2 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>3.2 0.2 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>
    <model name="bathroom_door_wall"><static>true</static><pose>7.85 6 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.3 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>1.3 0.2 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>
    <model name="bathroom_entrance_wall"><static>true</static><pose>9.25 6 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.3 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>1.3 0.2 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>
    <model name="upper_right_wall"><static>true</static><pose>11.55 6 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.5 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.5 0.2 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>
    <model name="bedroom_bath_divider"><static>true</static><pose>6.6 7.95 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 3.7 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 3.7 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>
    <model name="bath_entrance_divider"><static>true</static><pose>9 7.95 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 3.7 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 3.7 2.5</size></box></geometry><material><diffuse>0.88 0.86 0.8 1</diffuse></material></visual></link></model>

    <!-- Local primitive furniture, all static collision geometry. -->
    <model name="living_room_sofa"><static>true</static><pose>1.75 1.1 0.45 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.9 0.8 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.9 0.8 0.9</size></box></geometry><material><diffuse>0.18 0.35 0.55 1</diffuse></material></visual></link></model>
    <model name="living_room_table"><static>true</static><pose>4.15 1.95 0.38 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.9 0.9 0.76</size></box></geometry></collision><visual name="v"><geometry><box><size>0.9 0.9 0.76</size></box></geometry><material><diffuse>0.36 0.19 0.08 1</diffuse></material></visual></link></model>
    <model name="charging_dock_marker"><static>true</static><pose>5.35 3.1 0.08 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.16</length></cylinder></geometry><material><diffuse>0.15 0.8 0.25 1</diffuse><emissive>0.05 0.3 0.05 1</emissive></material></visual></link></model>
    <model name="kitchen_counter_south"><static>true</static><pose>10.8 0.85 0.45 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.2 0.7 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 0.7 0.9</size></box></geometry><material><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link></model>
    <model name="kitchen_counter_east"><static>true</static><pose>11.1 1.85 0.45 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.6 1.3 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 1.3 0.9</size></box></geometry><material><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link></model>
    <model name="kitchen_dining_table"><static>true</static><pose>7.75 1.95 0.38 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.1 1.1 0.76</size></box></geometry></collision><visual name="v"><geometry><box><size>1.1 1.1 0.76</size></box></geometry><material><diffuse>0.42 0.25 0.12 1</diffuse></material></visual></link></model>
    <model name="bedroom_bed"><static>true</static><pose>4.85 8.6 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.9 1.2 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>1.9 1.2 0.7</size></box></geometry><material><diffuse>0.62 0.42 0.65 1</diffuse></material></visual></link></model>
    <model name="bathroom_toilet"><static>true</static><pose>7.35 8.55 0.3 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.7 0.7 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 0.7 0.6</size></box></geometry><material><diffuse>0.96 0.96 0.96 1</diffuse></material></visual></link></model>
    <model name="bathroom_sink"><static>true</static><pose>8.4 7 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.6 0.6 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.6 0.6 0.7</size></box></geometry><material><diffuse>0.9 0.9 0.93 1</diffuse></material></visual></link></model>
    <model name="entrance_shoe_cabinet"><static>true</static><pose>10.7 8.55 0.45 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.0 0.5 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 0.5 0.9</size></box></geometry><material><diffuse>0.32 0.2 0.1 1</diffuse></material></visual></link></model>
  </world>
</sdf>
